# Lean Constellation local test environment template.
# Copy to .env for local use. .env is gitignored and must not be committed.

# Common Python path for local source checkouts.
LEAN_CONSTELLATION_CODEX_SDK_SRC=/path/to/codex/sdk/python/src
LEAN_CONSTELLATION_ARK_SRC=/path/to/agent-runtime-kit/src
LEAN_CONSTELLATION_TOOLKIT_SRC=/path/to/lean-mcp-toolkit/src
PYTHONPATH=${LEAN_CONSTELLATION_CODEX_SDK_SRC}:src:${LEAN_CONSTELLATION_ARK_SRC}

# Global Agent Provider selection. Individual agent_home_overrides take precedence.
LEAN_CONSTELLATION_DEFAULT_AGENT_PROVIDER_TYPE=codex

# Real Codex tests.
LEAN_CONSTELLATION_RUN_REAL_CODEX=1
LEAN_CONSTELLATION_CODEX_CONFIG_HOME=${PWD}/data/configs/codex
# Shared installed Lean toolchains for isolated production Agent homes. The directory must already exist.
LEAN_CONSTELLATION_SHARED_ELAN_HOME=${HOME}/.elan
LEAN_CONSTELLATION_CODEX_BASE_CONFIG_PATH=${PWD}/data/configs/codex/config.toml
LEAN_CONSTELLATION_CODEX_AUTH_JSON_PATH=${PWD}/data/configs/codex/auth.json
LEAN_CONSTELLATION_REAL_CODEX_STEP_TIMEOUT=300
LEAN_CONSTELLATION_MCP_TRANSPORT=http

# Production checkpoint and derived trace-report policy.
LEAN_CONSTELLATION_CHECKPOINT_REPO_FLOW_BOUNDARIES_ENABLED=true
LEAN_CONSTELLATION_CHECKPOINT_CONTENT_TASK_PROGRESS_ENABLED=false
LEAN_CONSTELLATION_AGENT_TRACE_REPORT_PERSISTENCE=latest_only
LEAN_CONSTELLATION_AGENT_TRACE_REPORT_INCLUDE_IN_SNAPSHOTS=false

# Real Lean / Lake fixtures.
LEAN_CONSTELLATION_RUN_REAL_LEAN=1
# Tests default to this exact version and never follow Elan stable/latest.
LEAN_CONSTELLATION_TEST_LEAN_VERSION=4.32.0
LEAN_CONSTELLATION_REAL_LEAN_TEMPLATE_ROOT=/path/to/local/lean/template
LEAN_CONSTELLATION_LOCAL_LAKE_CACHE_PROJECT_ROOT=/path/to/local/lean/template

# Live Lean MCP Toolkit.
LEAN_CONSTELLATION_REAL_TOOLKIT_BASE_URL=http://127.0.0.1:PORT
LEAN_CONSTELLATION_REAL_TOOLKIT_API_PREFIX=/api/v1

# Lean latency benchmarks.
LEAN_CONSTELLATION_LEAN_LATENCY_ITERATIONS=3
LEAN_CONSTELLATION_LEAN_LATENCY_TIMEOUT=120
