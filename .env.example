# Lean Constellation local test environment template.
# Copy to .env for local use. .env is gitignored and must not be committed.

# Common Python path for local source checkouts.
LEAN_CONSTELLATION_CODEX_SDK_SRC=/cephfs/xukangping/code/repos/tools/codex/sdk/python/src
LEAN_CONSTELLATION_ARK_SRC=/root/code/agent-runtime-kit/src
LEAN_CONSTELLATION_TOOLKIT_SRC=/root/code/lean-mcp-toolkit/src
PYTHONPATH=${LEAN_CONSTELLATION_CODEX_SDK_SRC}:src:${LEAN_CONSTELLATION_ARK_SRC}

# Real Codex tests.
LEAN_CONSTELLATION_RUN_REAL_CODEX=1
LEAN_CONSTELLATION_CODEX_CONFIG_HOME=/root/.codex
LEAN_CONSTELLATION_CODEX_BASE_CONFIG_PATH=/root/.codex/config.toml
LEAN_CONSTELLATION_CODEX_AUTH_JSON_PATH=/root/.codex/auth.json
LEAN_CONSTELLATION_REAL_CODEX_STEP_TIMEOUT=300
LEAN_CONSTELLATION_MCP_TRANSPORT=http

# Real Lean / Lake fixtures.
LEAN_CONSTELLATION_RUN_REAL_LEAN=1
LEAN_CONSTELLATION_REAL_LEAN_TEMPLATE_ROOT=/root/lean_projects/lean_template_428
LEAN_CONSTELLATION_LOCAL_LAKE_CACHE_PROJECT_ROOT=/root/lean_projects/lean_template_428

# Live Lean MCP Toolkit.
LEAN_CONSTELLATION_REAL_TOOLKIT_BASE_URL=http://127.0.0.1:8279
LEAN_CONSTELLATION_REAL_TOOLKIT_API_PREFIX=/api/v1

# Lean latency benchmarks.
LEAN_CONSTELLATION_LEAN_LATENCY_ITERATIONS=3
LEAN_CONSTELLATION_LEAN_LATENCY_TIMEOUT=120
